# .env.example — আমার পাড়া
# ব্যবহার: এই ফাইলটি কপি করে .env নামে নতুন ফাইল বানান, তারপর মানগুলো নিজের মতো বদলান:
#   cp .env.example .env
# ⚠️ .env ফাইলে আসল সিক্রেট থাকে — এটি কখনো Git-এ দেবেন না (.gitignore-এ আছে)।

# --- ডাটাবেস ---
POSTGRES_USER=amarpara # ডাটাবেস ব্যবহারকারীর নাম
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD # ডাটাবেস পাসওয়ার্ড — অবশ্যই বদলান
POSTGRES_DB=amar_para # ডাটাবেসের নাম

# --- ব্যাকএন্ড ---
DATABASE_URL=postgresql+psycopg://amarpara:CHANGE_ME_STRONG_PASSWORD@db:5432/amar_para # ব্যাকএন্ড যেভাবে ডাটাবেসে যুক্ত হবে (Docker-এ db হোস্ট নাম)
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS # JWT টোকেনের গোপন চাবি — লম্বা র‍্যান্ডম মান বদলান
ACCESS_TOKEN_EXPIRE_MINUTES=60 # লগইন টোকেন কত মিনিট বৈধ থাকবে
ENV=development # development / production
CORS_ORIGINS=http://localhost:4200,http://localhost:80 # ফ্রন্টএন্ড কোন ঠিকানা থেকে API ডাকতে পারবে
FRONTEND_URL=http://localhost:4200 # ফ্রন্টএন্ডের ঠিকানা (লিংক/নোটিফিকেশনে ব্যবহার হয়)

# --- OTP / ফোন যাচাই (SMS) ---
SMS_PROVIDER=log # ডেভ মোডে log (OTP সার্ভার লগে দেখা যায়); প্রোডাকশনে আসল provider (যেমন sslwireless / bulksmsbd) বসান
SMS_API_KEY= # SMS provider-এর API key — প্রোডাকশনে আবশ্যক, না দিলে OTP যাবে না
