# আমার পাড়া — ফ্রন্টএন্ড পরিবেশ ভেরিয়েবল (উদাহরণ)
# এই ফাইলটি কপি করে .env বা সরাসরি environment.ts-এ বসান।
# Angular-এ রানটাইম .env পড়া হয় না — API ঠিকানা src/environments/environment.ts-এ থাকে।

# ব্যাকএন্ড API-এর ঠিকানা (ডেভেলপমেন্ট)
API_URL=http://localhost:8000/api/v1

# ডেভ মোডে OTP স্ক্রিনে দেখাবে কি না (আসল SMS চালু হলে false)
DEV_SHOW_OTP=true
