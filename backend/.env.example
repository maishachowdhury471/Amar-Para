# Amar Para — Backend .env উদাহরণ
# আসল .env ফাইলটি কখনো গিটে দেবেন না। এই ফাইলটি কপি করে .env বানান।
ENV=development
DATABASE_URL=postgresql+psycopg://amarpara:amarpara@localhost:5432/amarpara
# SECRET_KEY: কমপক্ষে ৩২ অক্ষরের র‍্যান্ডম স্ট্রিং (openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-secret-key-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_POST=5
SMS_PROVIDER=log
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=AmarPara
JOB_SECRET=change-me-job-secret
RATE_LIMIT_DEFAULT=100/minute
